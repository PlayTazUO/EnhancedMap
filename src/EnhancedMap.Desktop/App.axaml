<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EnhancedMap.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <Color x:Key="SystemAccentColor">#E0A458</Color>
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#0F1218" Offset="0" />
      <GradientStop Color="#1A1F2A" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentBrush">#E0A458</SolidColorBrush>
    <SolidColorBrush x:Key="AccentHoverBrush">#F0BB74</SolidColorBrush>
    <SolidColorBrush x:Key="TextBrush">#E6E9EF</SolidColorBrush>
    <SolidColorBrush x:Key="MutedTextBrush">#9AA3B2</SolidColorBrush>
    <SolidColorBrush x:Key="FieldBrush">#1B202B</SolidColorBrush>
    <SolidColorBrush x:Key="FieldBorderBrush">#39424F</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceBrush">#20262F</SolidColorBrush>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2B333F" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#161B23" />
    </Style>

    <Style Selector="Button.accent">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="#171205" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#C98F49" />
      <Setter Property="BorderBrush" Value="#C98F49" />
    </Style>

    <Style Selector="Button.cmd">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.cmd:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2B333F" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.cmd.selected">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="#171205" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.cmd.selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
    </Style>

    <Style Selector="NumericUpDown">
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#232A34" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#2B333F" />
    </Style>

    <Style Selector="TabItem">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TabItem:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
  </Application.Styles>
</Application>
