<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EnhancedMap.Desktop.Windows.UserManagerWindow"
        Width="880" Height="620"
        MinWidth="700" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="User Manager">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Padding="12,8" Margin="0,0,0,10" CornerRadius="8"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Width="4" Height="18" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        <TextBlock Text="Enhanced Map — User Manager" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
      <Button Content="Close" Width="90" Click="OnCloseClick" />
    </StackPanel>

    <Grid RowDefinitions="*,140" RowSpacing="10">
      <Grid Grid.Row="0" ColumnDefinitions="*,340" ColumnSpacing="10">
        <DockPanel Grid.Column="0">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Name="RefreshButton" Content="Refresh" Click="OnRefreshClick" />
            <Button Name="NewButton" Content="New user" Click="OnNewClick" />
            <TextBlock Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
          </StackPanel>
          <Border CornerRadius="8" Background="{DynamicResource FieldBrush}"
                  BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
            <ListBox Name="UserList" SelectionChanged="OnSelectionChanged" />
          </Border>
        </DockPanel>

        <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" Padding="12">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8">
              <TextBlock Name="FormTitle" Text="New user" FontSize="16" FontWeight="Bold"
                         Foreground="{DynamicResource AccentBrush}" />

              <TextBlock Text="Username" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBox Name="UsernameBox" MaxLength="16" />

              <TextBlock Name="PasswordLabel" Text="Password" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBox Name="PasswordBox" PasswordChar="*" MaxLength="16" />

              <TextBlock Text="Room" Foreground="{DynamicResource MutedTextBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ComboBox Name="RoomCombo" Width="185" />
                <Button Name="RoomButton" Content="Move" Click="OnSetRoomClick" />
              </StackPanel>

              <TextBlock Text="Privileges" Foreground="{DynamicResource MutedTextBrush}" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ComboBox Name="PrivilegeCombo" Width="185" />
                <Button Name="PrivilegeButton" Content="Apply" Click="OnSetPrivilegesClick" />
              </StackPanel>

              <Button Name="PasswordButton" Content="Set password" Click="OnSetPasswordClick" HorizontalAlignment="Stretch" />
              <Button Name="AddButton" Classes="accent" Content="Add user" Click="OnAddClick" HorizontalAlignment="Stretch" />

              <Border Name="ActionsSeparator" Height="1" Background="{DynamicResource FieldBorderBrush}" Margin="0,4" />

              <StackPanel Name="ActionsPanel" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Name="KickButton" Content="Kick" Click="OnKickClick" />
                  <Button Name="BanButton" Content="Ban" Click="OnBanClick" />
                  <Button Name="EnableButton" Content="Enable" Click="OnEnableClick" />
                </StackPanel>
                <Button Name="RemoveButton" Content="Delete account" Click="OnRemoveClick" HorizontalAlignment="Stretch" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <Border Grid.Row="1" CornerRadius="8" Background="{DynamicResource FieldBrush}"
              BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" Padding="8">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2,0,2,6">
            <TextBlock Text="Server response" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Clear" Padding="10,3" Click="OnClearOutputClick" />
          </Grid>
          <TextBox Name="OutputBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                   Background="Transparent" BorderThickness="0"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
