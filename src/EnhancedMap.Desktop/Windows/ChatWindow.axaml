<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EnhancedMap.Desktop.Windows.ChatWindow"
        Width="300" Height="300"
        MinWidth="200" MinHeight="120"
        ShowInTaskbar="False"
        Title="Chat">
  <DockPanel>
    <TextBox Name="InputBox" DockPanel.Dock="Bottom"
             Margin="4" AcceptsReturn="True" MaxLength="100"
             Watermark="Type a message..." />
    <ScrollViewer Name="Scroller" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Name="Messages" Margin="4" />
    </ScrollViewer>
  </DockPanel>
</Window>
