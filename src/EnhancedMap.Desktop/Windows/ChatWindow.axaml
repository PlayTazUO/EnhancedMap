<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EnhancedMap.Desktop.Windows.ChatWindow"
        Width="500" Height="500"
        MinWidth="200" MinHeight="120"
        ShowInTaskbar="False"
        Title="Chat">
  <Window.Background>
    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Color="#0F1218" Offset="0" />
      <GradientStop Color="#1A1F2A" Offset="1" />
    </LinearGradientBrush>
  </Window.Background>

  <Window.Resources>
    <Color x:Key="SystemAccentColor">#E0A458</Color>
    <SolidColorBrush x:Key="AccentBrush">#E0A458</SolidColorBrush>
    <SolidColorBrush x:Key="AccentHoverBrush">#F0BB74</SolidColorBrush>
    <SolidColorBrush x:Key="TextBrush">#E6E9EF</SolidColorBrush>
    <SolidColorBrush x:Key="MutedTextBrush">#9AA3B2</SolidColorBrush>
    <SolidColorBrush x:Key="FieldBrush">#1B202B</SolidColorBrush>
    <SolidColorBrush x:Key="FieldBorderBrush">#39424F</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceBrush">#20262F</SolidColorBrush>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>

    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2B333F" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#161B23" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource FieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FieldBorderBrush}" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Padding="12,8" Margin="0,0,0,10" CornerRadius="8"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Width="4" Height="18" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        <TextBlock Text="Enhanced Map — Chat" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <TextBox Name="InputBox" DockPanel.Dock="Bottom"
             Margin="0,10,0,0" AcceptsReturn="True" MaxLength="100"
             Watermark="Type a message..." />

    <Border CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" Padding="4">
      <ScrollViewer Name="Scroller" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Name="Messages" Margin="4" Spacing="2" />
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
