<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EnhancedMap.Desktop.Windows.ChatWindow"
        Width="500" Height="500"
        MinWidth="200" MinHeight="120"
        ShowInTaskbar="False"
        Title="Chat">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Padding="12,8" Margin="0,0,0,10" CornerRadius="8"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Width="4" Height="18" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        <TextBlock Text="Enhanced Map — Chat" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <TextBox Name="InputBox" DockPanel.Dock="Bottom"
             Margin="0,10,0,0" AcceptsReturn="True" MaxLength="100"
             Watermark="Type a message..." />

    <Border CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" Padding="4">
      <ScrollViewer Name="Scroller" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel Name="Messages" Margin="4" Spacing="2" />
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
