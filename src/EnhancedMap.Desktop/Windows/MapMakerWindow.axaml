<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EnhancedMap.Desktop.Windows.MapMakerWindow"
        Width="640" Height="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="Map Maker">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Padding="12,8" Margin="0,0,0,10" CornerRadius="8"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Width="4" Height="18" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Enhanced Map — Map Maker" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                   Text="EnhancedMap draws its own map images from your Ultima Online client files, so they must be generated once before the map can be shown. Pick your client folder below: every map file found is listed with its size pre-filled. Only change a name or size if your shard uses custom maps, then click Generate." />
      </StackPanel>
    </Border>

    <Grid>
      <Grid Name="MainPanel" RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
          <TextBlock Grid.Column="0" Text="UO folder:" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBox Grid.Column="1" Name="FolderBox" IsReadOnly="True" />
          <Button Grid.Column="2" Content="Browse..." Margin="8,0,0,0" Click="OnBrowseClick" />
        </Grid>

        <TextBlock Grid.Row="1" Name="StatusText" Foreground="#D9534F" TextWrapping="Wrap" Margin="0,0,0,6" />

        <Border Grid.Row="2" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" Padding="8">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="70,*,130,130,32" Margin="0,0,0,6">
              <TextBlock Grid.Column="0" Text="Index" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBlock Grid.Column="2" Text="Width" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
              <TextBlock Grid.Column="3" Text="Height" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
            </Grid>
            <ScrollViewer>
              <StackPanel Name="MapsPanel" Spacing="6" />
            </ScrollViewer>
          </DockPanel>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
          <Button Content="Generate" Width="110" Classes="accent" Click="OnGenerateClick" />
          <Button Content="Close" Width="90" Click="OnCloseClick" />
        </StackPanel>
      </Grid>

      <DockPanel Name="ProgressPanel" IsVisible="False">
        <TextBlock DockPanel.Dock="Top" Name="ProgressTitle" Text="Generating maps..." FontSize="18" Margin="0,0,0,8" />
        <Button DockPanel.Dock="Bottom" Name="CloseButton" Content="Close" Width="90" HorizontalAlignment="Right" Margin="0,8,0,0" IsEnabled="False" Click="OnCloseClick" />
        <TextBox Name="ProgressBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
