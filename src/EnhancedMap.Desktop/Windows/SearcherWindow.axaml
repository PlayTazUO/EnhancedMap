<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EnhancedMap.Desktop.Windows.SearcherWindow"
        Width="420" Height="480"
        MinWidth="320" MinHeight="240"
        ShowInTaskbar="False"
        Title="Search Places">
  <DockPanel Margin="8">
    <TextBox Name="SearchBox" DockPanel.Dock="Top" Watermark="Search..." Margin="0,0,0,6" TextChanged="OnSearchChanged" />
    <ListBox Name="Results" DoubleTapped="OnResultDoubleTapped" />
  </DockPanel>
</Window>
