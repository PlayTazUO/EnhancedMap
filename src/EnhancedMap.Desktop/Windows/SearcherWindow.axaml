<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EnhancedMap.Desktop.Windows.SearcherWindow"
        Width="420" Height="540"
        MinWidth="320" MinHeight="240"
        ShowInTaskbar="False"
        Title="Search Markers">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Top" Padding="12,8" Margin="0,0,0,10" CornerRadius="8"
            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Border Width="4" Height="18" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
        <TextBlock Text="Enhanced Map — Search Markers" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <TextBox Name="SearchBox" DockPanel.Dock="Top" Watermark="Search..." Margin="0,0,0,6" TextChanged="OnSearchChanged" />
    <Border CornerRadius="8" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource FieldBorderBrush}" BorderThickness="1" Padding="4">
      <ListBox Name="Results" DoubleTapped="OnResultDoubleTapped" />
    </Border>
  </DockPanel>
</Window>
