<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>EnhancedMap</AssemblyName>
    <RootNamespace>EnhancedMap</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\Resources\**\*.png" Link="Resources\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\Resources\**\*.gif" Link="Resources\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\Resources\**\*.wav" Link="Resources\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
  </ItemGroup>

</Project>
